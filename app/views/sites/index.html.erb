<div class="header">
  <h1>Sites</h1>
  <%= link_to "Add site", new_site_path, class: "btn" %>
</div>

<% if @sites.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Domain</th>
        <th>Tracking</th>
        <th>Keywords</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @sites.each do |site| %>
        <tr>
          <td><%= link_to site.name, site %></td>
          <td><%= site.domain %></td>
          <td><%= site.tracking_enabled? ? "Enabled" : "Disabled" %></td>
          <td><%= site.keywords.size %></td>
          <td class="actions">
            <%= link_to "Edit", edit_site_path(site) %>
            <%= button_to "Delete", site, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No sites yet. Add one to get started.</p>
<% end %>
