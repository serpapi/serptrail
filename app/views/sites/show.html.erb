<%= turbo_stream_from @site, :keywords %>

<div class="header">
  <h1><%= @site.name %></h1>
  <div class="header-actions">
    <%= link_to "Table", table_site_path(@site), class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_site_path(@site), class: "btn btn-secondary" %>
    <%= link_to "+ Add", new_site_keyword_path(@site), class: "btn" %>
  </div>
</div>

<p class="site-meta">
  <strong>Domain:</strong> <%= @site.domain %> |
  <strong>Tracking:</strong> <%= @site.tracking_enabled? ? "Enabled" : "Disabled" %>
</p>

<% if @keywords.any? %>
  <div class="card-grid">
    <% @keywords.each do |keyword| %>
      <%= render "keywords/keyword_card", keyword: keyword, site: @site %>
    <% end %>
  </div>
<% else %>
  <%= empty_state("No keywords yet.", "Add the first keyword", new_site_keyword_path(@site)) %>
<% end %>
