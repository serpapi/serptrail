<div class="header">
  <h1><%= @site.name %></h1>
  <div class="header-actions">
    <%= link_to "Cards", @site, class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_site_path(@site), class: "btn btn-secondary" %>
    <%= link_to "+ Add", new_site_keyword_path(@site), class: "btn" %>
  </div>
</div>

<p class="site-meta">
  <strong>Domain:</strong> <%= @site.domain %> |
  <strong>Tracking:</strong> <%= @site.tracking_enabled? ? "Enabled" : "Disabled" %>
</p>

<% if @keyword_targets.any? %>
  <table>
    <thead>
      <tr>
        <th>Query</th>
        <th>Frequency</th>
        <th>Position</th>
        <th>Change</th>
        <th>Ranked URL</th>
        <th>Last Checked</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @keyword_targets.each do |keyword_target| %>
        <% keyword = keyword_target.keyword %>
        <% latest = keyword_target.latest_check %>
        <% change = keyword_target.position_change %>
        <tr>
          <td><%= link_to site_keyword_path(@site, keyword) do %><%= keyword.query %> <span class="keyword-flag"><%= keyword.locations.map { |l| country_flag(l) }.join(" ") %></span><% end %></td>
          <% if @site.tracking_enabled? %>
            <td title="<%= next_check_label(keyword) %>"><%= keyword.check_frequency.capitalize %></td>
          <% else %>
            <td><%= keyword.check_frequency.capitalize %></td>
          <% end %>
          <td>
            <% if latest %>
              <%= link_to(latest.position || "Not ranked", site_keyword_checks_path(@site, keyword)) %>
            <% else %>
              <span class="muted">--</span>
            <% end %>
          </td>
          <td>
            <% if change && change != 0 %>
              <% if change > 0 %>
                <span class="change-up">+<%= change %></span>
              <% else %>
                <span class="change-down"><%= change %></span>
              <% end %>
            <% end %>
          </td>
          <td class="url-cell"><%= latest&.url %></td>
          <td><%= keyword.last_checked_at && time_ago_in_words(keyword.last_checked_at) + " ago" %></td>
          <td class="actions">
            <%= button_to "Check", check_site_keyword_path(@site, keyword), method: :post %>
            <%= link_to "Edit", edit_site_keyword_path(@site, keyword) %>
            <%= button_to "Delete", site_keyword_path(@site, keyword), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <%= empty_state("No keywords yet.", "Add the first keyword", new_site_keyword_path(@site)) %>
<% end %>
