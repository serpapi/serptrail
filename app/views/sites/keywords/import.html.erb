<div class="header">
  <h1>Import keywords for <%= @site.name %></h1>
</div>

<%= form_with url: import_site_keywords_path(@site), scope: :keyword do |form| %>
  <div class="field">
    <%= form.label :queries, "Keywords" %>
    <%= form.text_area :queries, rows: 10, placeholder: "iphone 18\nbuy iphone 18\niphone 18 review", autocomplete: "off" %>
    <small class="field-hint">One keyword per line</small>
  </div>

  <div class="field"
       data-controller="location-select"
       data-location-select-initial-value="<%= @keyword.locations.to_json %>">
    <label>Locations</label>
    <div class="location-select-control" data-action="click->location-select#focusInput">
      <div data-location-select-target="tags"></div>
      <input type="text"
             class="location-select-search"
             autocomplete="off"
             spellcheck="false"
             placeholder="Add location..."
             data-location-select-target="input"
             data-action="focus->location-select#open click->location-select#open input->location-select#filter">
    </div>
    <div class="location-select-dropdown" data-location-select-target="dropdown" hidden></div>
    <div data-location-select-target="hiddenInputs"></div>
  </div>

  <div class="field">
    <%= form.label :check_frequency, "Check frequency" %>
    <div class="btn-group">
      <% Keyword.check_frequencies.each_key do |freq| %>
        <label class="btn-group-option">
          <%= form.radio_button :check_frequency, freq, class: "btn-group-input" %>
          <span class="btn-group-label"><%= freq.capitalize %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="field search-depth-field" data-controller="search-depth">
    <div class="search-depth-header">
      <%= form.label :search_pages, "Search depth" %>
      <output class="search-depth-value" data-search-depth-target="value"><%= pluralize(@keyword.search_pages, "page") %></output>
    </div>
    <%= form.range_field :search_pages,
      min: 1,
      max: 5,
      step: 1,
      class: "search-depth-slider",
      data: { search_depth_target: "input", action: "input->search-depth#update" } %>
    <div class="search-depth-scale" aria-hidden="true">
      <span>1 page</span>
      <span>5 pages</span>
    </div>
    <small class="field-hint">Checks up to <span data-search-depth-target="results"><%= @keyword.search_pages * 10 %></span> Google results. Each additional page uses another SerpApi credit per keyword and location, increasing your credit usage.</small>
  </div>

  <div class="actions">
    <%= form.submit "Import", class: "btn" %>
  </div>
<% end %>

<%= link_to "Back to site", @site, class: "back-link" %>
