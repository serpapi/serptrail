<%= form_with(model: site) do |form| %>
  <% if site.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(site.errors.count, "error") %> prohibited this site from being saved:</h2>
      <ul>
        <% site.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, autocomplete: "off" %>
  </div>

  <div class="field">
    <%= form.label :domain %>
    <%= form.text_field :domain, required: true, placeholder: "example.com", autocomplete: "off" %>
  </div>

  <div class="actions">
    <%= form.submit(site.new_record? ? "Create" : "Update", class: "btn") %>
  </div>
<% end %>
