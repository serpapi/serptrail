<%= form_with(model: [site, keyword]) do |form| %>
  <% if keyword.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(keyword.errors.count, "error") %> prohibited this keyword from being saved:</h2>
      <ul>
        <% keyword.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :query %>
    <%= form.text_field :query, required: true, placeholder: "e.g. best ruby gems" %>
  </div>

  <div class="field" data-controller="location-select">
    <%= form.label :location, "Location" %>
    <%= form.hidden_field :location, data: { "location-select-target": "hidden" } %>
    <input type="text"
           class="location-select-input"
           autocomplete="off"
           spellcheck="false"
           data-location-select-target="input"
           data-action="focus->location-select#open input->location-select#filter">
    <div class="location-select-dropdown" data-location-select-target="dropdown" hidden></div>
  </div>

  <div class="field">
    <%= form.label :check_frequency, "Check frequency" %>
    <div class="btn-group">
      <% Keyword.check_frequencies.each_key do |freq| %>
        <label class="btn-group-option">
          <%= form.radio_button :check_frequency, freq, class: "btn-group-input" %>
          <span class="btn-group-label"><%= freq.capitalize %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="actions">
    <%= form.submit class: "btn" %>
  </div>
<% end %>
