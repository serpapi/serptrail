<%
site ||= nil
%>
<%= form_with(model: [site, keyword].compact) do |form| %>
  <% if keyword.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(keyword.errors.count, "error") %> prohibited this keyword from being saved:</h2>
      <ul>
        <% keyword.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :query %>
    <%= form.text_field :query, required: true, placeholder: "e.g. best ruby gems", autocomplete: "off" %>

    <% if site.present? && keyword.new_record? %>
      <small class="import-prompt"><%= link_to "Adding more keywords at once?", import_site_keywords_path(site) %></small>
    <% end %>
  </div>

  <div class="field"
       data-controller="location-select"
       data-location-select-initial-value="<%= (keyword.locations.presence || [ "us" ]).to_json %>"
       data-location-select-search-url-value="<%= locations_path %>">
    <label>Locations</label>
    <div class="location-select-control" data-action="click->location-select#focusInput">
      <div data-location-select-target="tags"></div>
      <input type="text"
             class="location-select-search"
             autocomplete="off"
             spellcheck="false"
             placeholder="Add location..."
             data-location-select-target="input"
             data-action="focus->location-select#open click->location-select#open input->location-select#filter">
    </div>
    <div class="location-select-dropdown" data-location-select-target="dropdown" hidden></div>
    <div data-location-select-target="hiddenInputs"></div>
    <small class="field-hint">Choose a country for localization or search for a city for location-based search.</small>
  </div>

  <div class="field">
    <%= form.label :check_frequency, "Check frequency" %>
    <div class="btn-group">
      <% Keyword.check_frequencies.each_key do |freq| %>
        <label class="btn-group-option">
          <%= form.radio_button :check_frequency, freq, class: "btn-group-input" %>
          <span class="btn-group-label"><%= freq.capitalize %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="field search-depth-field" data-controller="search-depth">
    <div class="search-depth-header">
      <%= form.label :search_pages, "Search depth" %>
      <output class="search-depth-value" data-search-depth-target="value"><%= pluralize(keyword.search_pages, "page") %></output>
    </div>
    <%= form.range_field :search_pages,
      min: 1,
      max: 5,
      step: 1,
      class: "search-depth-slider",
      data: { search_depth_target: "input", action: "input->search-depth#update" } %>
    <div class="search-depth-scale" aria-hidden="true">
      <span>1 page</span>
      <span>5 pages</span>
    </div>
    <small class="field-hint">Checks up to <span data-search-depth-target="results"><%= keyword.search_pages * 10 %></span> Google results. Each additional page uses another SerpApi credit per location, increasing your credit usage.</small>
  </div>


  <% if site.present? && keyword.persisted? %>
    <div class="field toggle-field">
      <label for="keyword_target_tracking_enabled">Enable checking</label>
      <label class="toggle">
        <input type="hidden" name="keyword_target[tracking_enabled]" value="0">
        <input type="checkbox" id="keyword_target_tracking_enabled"
              name="keyword_target[tracking_enabled]" value="1"
              class="toggle-input"
              <%= "checked" if keyword_target.tracking_enabled? %>>
        <span class="toggle-slider"></span>
      </label>
    </div>
  <% elsif site.blank? %>
    <div class="field">
      <label>Sites to track</label>
      <%= hidden_field_tag "keyword[site_ids][]", "" %>
      <% selected_site_ids = keyword.keyword_targets.map(&:site_id) %>
      <% if sites.any? %>
        <div class="checkbox-grid">
          <% sites.each do |site| %>
            <label class="checkbox-card">
              <%= check_box_tag "keyword[site_ids][]", site.id, selected_site_ids.include?(site.id), id: "keyword_site_ids_#{site.id}" %>
              <span>
                <span class="checkbox-card-title"><%= site.name %></span>
                <span class="checkbox-card-meta"><%= site.domain %></span>
              </span>
            </label>
          <% end %>
        </div>
        <small class="field-hint">Optional. You can track this keyword now and attach sites later.</small>
      <% else %>
        <p class="muted">No sites yet. You can still create this keyword and attach sites later.</p>
      <% end %>
    </div>
  <% end %>

  <div class="actions">
    <%= form.submit(keyword.new_record? ? "Create" : "Update", class: "btn") %>
  </div>
<% end %>
