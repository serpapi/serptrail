<div id="keyword_data">
  <% series = keyword.locations.map { |loc|
    {
      label: "#{country_flag(loc)} #{country_name(loc)}",
      checks: (checks_by_location[loc] || []).sort_by(&:checked_at)
    }
  } %>
  <%= ranking_chart(series, empty_message: has_checks ? "Not enough data yet." : "Checking...") %>

  <table>
    <thead>
      <tr>
        <th>Location</th>
        <th>Position</th>
        <th>Change</th>
      </tr>
    </thead>
    <tbody>
      <% location_stats.each_with_index do |stat, i| %>
        <tr>
          <td>
            <span class="location-legend-swatch" style="background: <%= location_color(i) %>"></span>
            <%= country_flag(stat[:location]) %> <%= country_name(stat[:location]) %>
          </td>
          <td>
            <% if stat[:latest] %>
              <%= link_to(stat[:latest].position || "N/R", site_keyword_checks_path(keyword.site, keyword)) %>
            <% else %>
              <span class="muted">--</span>
            <% end %>
          </td>
          <td>
            <% if stat[:change] && stat[:change] != 0 %>
              <% if stat[:change] > 0 %>
                <span class="change-up">+<%= stat[:change] %></span>
              <% else %>
                <span class="change-down"><%= stat[:change] %></span>
              <% end %>
            <% else %>
              <span class="muted">--</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
