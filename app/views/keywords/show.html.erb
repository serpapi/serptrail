<%= turbo_stream_from @keyword %>

<p class="breadcrumb">
  <%= link_to @site.name, @site %> &rsaquo;
  <strong><%= @keyword.query %></strong>
</p>

<div class="header">
  <h1><%= @keyword.query %></h1>
  <div class="header-actions">
    <%= link_to "History", site_keyword_checks_path(@site, @keyword), class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_site_keyword_path(@site, @keyword), class: "btn btn-secondary" %>
  </div>
</div>

<%= render "keywords/keyword_data",
      keyword: @keyword,
      checks_by_location: @checks_by_location,
      location_stats: @location_stats,
      has_checks: @has_checks %>
