<p class="breadcrumb">
  <%= link_to @site.name, @site %> &rsaquo;
  <strong><%= @keyword.query %></strong>
</p>

<div class="header">
  <h1><%= @keyword.query %></h1>
  <div class="header-actions">
    <%= link_to "History", site_keyword_checks_path(@site, @keyword), class: "btn btn-secondary" %>
    <%= link_to "Edit", edit_site_keyword_path(@site, @keyword), class: "btn btn-secondary" %>
  </div>
</div>

<% sparkline = multi_location_sparkline(@checks_by_location, @keyword.locations, width: 960, height: 220) %>
<% if sparkline %>
  <div class="history-chart">
    <%= sparkline %>
  </div>

  <div class="location-legend">
    <% @keyword.locations.each_with_index do |location, i| %>
      <span class="location-legend-item">
        <span class="location-legend-swatch" style="background: <%= location_color(i) %>"></span>
        <%= country_flag(location) %> <%= country_name(location) %>
      </span>
    <% end %>
  </div>
<% else %>
  <p class="muted"><%= @has_checks ? "Not enough data yet." : "Checking..." %></p>
<% end %>

<table>
  <thead>
    <tr>
      <th>Location</th>
      <th>Position</th>
      <th>Change</th>
    </tr>
  </thead>
  <tbody>
    <% @location_stats.each_with_index do |stat, i| %>
      <tr>
        <td>
          <span class="location-legend-swatch" style="background: <%= location_color(i) %>"></span>
          <%= country_flag(stat[:location]) %> <%= country_name(stat[:location]) %>
        </td>
        <td>
          <% if stat[:latest] %>
            <%= link_to(stat[:latest].position || "N/R", site_keyword_checks_path(@site, @keyword)) %>
          <% else %>
            <span class="muted">--</span>
          <% end %>
        </td>
        <td>
          <% if stat[:change] && stat[:change] != 0 %>
            <% if stat[:change] > 0 %>
              <span class="change-up">+<%= stat[:change] %></span>
            <% else %>
              <span class="change-down"><%= stat[:change] %></span>
            <% end %>
          <% else %>
            <span class="muted">--</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
