<div class="header">
  <h1>Settings</h1>
</div>

<%= form_with(model: @tenant, url: settings_path) do |form| %>
  <% if @tenant.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@tenant.errors.count, "error") %> prohibited settings from being saved:</h2>
      <ul>
        <% @tenant.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :serpapi_key, "SerpApi key" %>
    <%= form.password_field :serpapi_key, value: @tenant.serpapi_key, placeholder: "Enter SerpApi key", autocomplete: "off" %>
    <span class="field-hint">You can get your SerpApi key in your <%= link_to "SerpApi dashboard", "https://serpapi.com/manage-api-key", target: "_blank", rel: "noopener" %>.</span>
  </div>

  <div class="field">
    <%= form.label :openai_api_key, "OpenAI key" %>
    <%= form.password_field :openai_api_key, value: @tenant.openai_api_key, placeholder: "Enter OpenAI API key", autocomplete: "off" %>
    <span class="field-hint">Used by the chat assistant. You can get your key in your <%= link_to "OpenAI API keys", "https://platform.openai.com/api-keys", target: "_blank", rel: "noopener" %>.</span>
  </div>

  <div class="actions">
    <%= form.submit "Save", class: "btn" %>
  </div>
<% end %>
