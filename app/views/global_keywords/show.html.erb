<p class="breadcrumb">
  <%= link_to "Keywords", keywords_path %> &rsaquo;
  <strong><%= @keyword.query %></strong>
</p>

<div class="header">
  <h1><%= @keyword.query %></h1>
  <div class="header-actions">
    <%= button_to "Check", check_keyword_path(@keyword), method: :post, class: "btn" %>
    <%= link_to "Edit", edit_keyword_path(@keyword), class: "btn btn-secondary" %>
  </div>
</div>

<% if @keyword.locations.any? %>
  <p class="site-meta">
    <strong>Locations:</strong> <%= @keyword.locations.map { |location| "#{country_flag(location)} #{country_name(location)}" }.to_sentence %> |
    <strong>Frequency:</strong> <%= @keyword.check_frequency.capitalize %> |
    <strong><%= next_check_label(@keyword) %></strong>
  </p>
<% end %>

<section class="section-block">
  <div class="header">
    <h2>Tracked sites</h2>
  </div>

  <% if @keyword_targets.any? %>
    <div class="card-grid">
      <% @keyword_targets.each do |keyword_target| %>
        <% site = keyword_target.site %>
        <% latest = keyword_target.latest_check %>
        <% change = keyword_target.position_change %>
        <div class="card">
          <div class="card-header">
            <h3 class="card-title"><%= link_to site.domain, site_keyword_path(site, @keyword) %></h3>
            <div class="card-actions">
              <%= link_to "History", site_keyword_checks_path(site, @keyword) %>
              <%= link_to "Site", site_path(site) %>
            </div>
          </div>
          <div class="card-stats">
            <div class="card-stat">
              <span class="card-stat-label">Position</span>
              <span class="card-stat-value"><%= latest&.position || (latest ? "N/R" : "--") %></span>
            </div>
            <div class="card-stat">
              <span class="card-stat-label">Change</span>
              <span class="card-stat-value">
                <% if change && change != 0 %>
                  <% if change > 0 %>
                    <span class="change-up">+<%= change %></span>
                  <% else %>
                    <span class="change-down"><%= change %></span>
                  <% end %>
                <% else %>
                  <span class="muted">--</span>
                <% end %>
              </span>
            </div>
            <div class="card-stat">
              <span class="card-stat-label">Checks</span>
              <span class="card-stat-value"><%= keyword_target.checks.count %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= empty_state("No sites attached yet. Search runs will still be saved for this keyword.", "Attach sites", edit_keyword_path(@keyword)) %>
  <% end %>
</section>

<section class="section-block">
  <div class="header">
    <h2>Search runs</h2>
  </div>

  <% if @search_runs.any? %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Location</th>
          <th>Status</th>
          <th>Checks</th>
          <th>SerpApi</th>
        </tr>
      </thead>
      <tbody>
        <% @search_runs.each do |search_run| %>
          <tr>
            <td title="Ran for query <%= search_run.query %>"><%= search_run.checked_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= country_flag(search_run.location) %> <%= country_name(search_run.location) %></td>
            <td><%= tag.span search_run.status.capitalize, class: [ "status", "status-#{search_run.status}" ] %></td>
            <td><%= search_run.checks.count %></td>
            <td>
              <% if search_run.serpapi_search_id.present? %>
                <%= link_to "Open", "https://serpapi.com/searches/#{search_run.serpapi_search_id}/inspect", title: "Open in SerpApi", target: "_blank", rel: "noopener", class: "serpapi-link" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No search runs recorded yet.</p>
  <% end %>
</section>
