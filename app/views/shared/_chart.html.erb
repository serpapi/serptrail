<% series_keys = series.each_with_index.map { |_, i| "s#{i + 1}" } %>
<% checks_by_key = series.each_with_index.each_with_object({}) { |(s, i), h| h["s#{i + 1}"] = s[:checks] } %>
<% sparkline = multi_location_sparkline(checks_by_key, series_keys, width: width, height: height) %>
<% if sparkline %>
  <div class="history-chart">
    <%= sparkline %>
  </div>
  <div class="location-legend">
    <% series.each_with_index do |s, idx| %>
      <span class="location-legend-item">
        <span class="location-legend-swatch" style="background: <%= location_color(idx) %>"></span>
        <%= s[:label] %>
      </span>
    <% end %>
  </div>
<% else %>
  <p class="muted"><%= empty_message %></p>
<% end %>
