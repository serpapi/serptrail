<p class="breadcrumb">
  <%= link_to @site.name, @site %> &rsaquo;
  <strong><%= @keyword.query %></strong> <%= @keyword.locations.map { |l| country_flag(l) }.join(" ") %>
</p>

<div class="header">
  <h1>Check History</h1>
</div>

<% success_checks = @checks.select(&:success?) %>
<% sparkline = position_sparkline(success_checks, width: 960, height: 200) %>
<% if sparkline %>
  <div class="history-chart">
    <%= sparkline %>
  </div>
<% end %>

<% if @checks.any? %>
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Location</th>
        <th>Position</th>
        <th>AI Overview</th>
        <th>URL</th>
        <th>SerpApi</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @checks.each do |check| %>
        <tr>
          <td title="Ran for query <%= check.query %>"><%= check.checked_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= country_flag(check.location) %></td>
          <td><%= check.position || "Not ranked" %></td>
          <td>
            <% if check.ai_overview_cited? %>
              <span class="ai-cited">Cited</span>
            <% elsif check.ai_overview_present? %>
              <span class="muted">Not cited</span>
            <% elsif !check.ai_overview_present.nil? %>
              <span class="muted">Not present</span>
            <% end %>
          </td>
          <td class="url-cell"><%= check.url %></td>
          <td>
            <% if check.search_run&.serpapi_search_id.present? %>
              <%= link_to "Open", "https://serpapi.com/searches/#{check.search_run.serpapi_search_id}/inspect", title: "Open in SerpApi", target: "_blank", rel: "noopener", class: "serpapi-link" %>
            <% end %>
          </td>
          <td>
            <%= tag.span check.status.capitalize, class: [ "status", "status-#{check.status}" ] %>
            <% if (summary = check.error_summary) %>
              <br><small class="muted"><%= summary %></small>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No checks recorded yet.</p>
<% end %>
