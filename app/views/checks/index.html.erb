<p class="breadcrumb">
  <%= link_to @site.name, @site %> &rsaquo;
  <strong><%= @keyword.query %></strong> <%= country_flag(@keyword.location) %>
</p>

<div class="header">
  <h1>Check History</h1>
</div>

<% success_checks = @checks.select(&:success?) %>
<% sparkline = position_sparkline(success_checks, width: 960, height: 200) %>
<% if sparkline %>
  <div class="history-chart">
    <%= sparkline %>
  </div>
<% end %>

<% if @checks.any? %>
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Position</th>
        <th>URL</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @checks.each do |check| %>
        <tr>
          <td><%= check.checked_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= check.position || "Not ranked" %></td>
          <td class="url-cell"><%= check.url %></td>
          <td>
            <span class="status status-<%= check.status %>"><%= check.status.capitalize %></span>
            <% if (summary = check.error_summary) %>
              <br><small class="muted"><%= summary %></small>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No checks recorded yet.</p>
<% end %>
