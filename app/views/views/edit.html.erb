<% series = @view.series.to_a %>

<div class="header">
  <h1><%= @view.name %></h1>
</div>

<%= form_with url: view_path(@view), method: :patch, local: true, class: "compare-form" do %>
  <% [["view[series][0]", "Series 1", series[0]], ["view[series][1]", "Series 2", series[1]]].each do |key, label, saved_series| %>
    <fieldset class="compare-series" data-controller="series-select">
      <legend><%= label %></legend>

      <div class="form-group">
        <label>Site</label>
        <select name="<%= key %>[site_id]"
                data-series-select-target="siteSelect"
                data-action="change->series-select#siteChanged">
          <%= options_for_select(
                @sites.map { |site| ["#{site.name} (#{site.domain})", site.id] },
                saved_series&.tracked_site&.id
              ) %>
        </select>
      </div>

      <div class="form-group">
        <label>Keyword</label>
        <select name="<%= key %>[keyword_target_id]"
                data-series-select-target="keywordSelect"
                data-action="change->series-select#keywordChanged">
          <%= options_for_select(
                @all_keyword_targets.map { |keyword_target|
                  keyword = keyword_target.keyword
                  [ keyword.query, keyword_target.id, { data: { site_id: keyword_target.site_id, locations: keyword.locations.to_json } } ]
                },
                saved_series&.keyword_target_id
              ) %>
        </select>
      </div>

      <div class="form-group">
        <label>Location</label>
        <select name="<%= key %>[location]"
                data-series-select-target="locationSelect">
          <%= options_for_select(
                saved_series&.tracked_keyword&.locations.to_a.map { |code| ["#{country_flag(code)} #{country_name(code)}", code] },
                saved_series&.location
              ) %>
        </select>
      </div>
    </fieldset>
  <% end %>

  <div class="compare-actions">
    <%= submit_tag "Update", class: "btn btn-primary" %>
    <%= link_to "Cancel", view_path(@view), class: "btn btn-secondary" %>
  </div>
<% end %>
