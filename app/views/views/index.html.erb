<div class="header">
  <h1>Views</h1>
  <div class="header-actions">
    <%= link_to "+ Add", new_view_path, class: "btn" %>
  </div>
</div>

<% if @views.any? %>
  <div class="card-grid">
    <% @views.each do |saved_view| %>
      <% valid_series = saved_view.series.select { |s| s.keyword_target.present? } %>
      <% checks_by_series = {} %>
      <% compare_params = {} %>
      <% valid_series.each_with_index do |s, idx| %>
        <% key = "s#{idx + 1}" %>
        <% checks_by_series[key] = s.tracked_checks.select { |c| c.success? && c.location == s.location }.sort_by(&:checked_at) %>
        <% compare_params[key] = { keyword_target_id: s.keyword_target_id, location: s.location, site_id: s.tracked_site.id } %>
      <% end %>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title"><%= link_to saved_view.name, view_path(saved_view) %></h2>
          <div class="card-actions">
            <%= button_to "Delete", view_path(saved_view), method: :delete, data: { turbo_confirm: "Delete this view?" } %>
          </div>
        </div>

        <div class="view-series">
          <% valid_series.each_with_index do |s, idx| %>
            <div class="view-series-row">
              <span class="location-legend-swatch" style="background: <%= location_color(idx) %>"></span>
              <span><strong><%= s.tracked_site.domain %></strong> &mdash; <%= s.tracked_keyword.query %> &mdash; <%= country_flag(s.location) %> <%= country_name(s.location) %></span>
            </div>
          <% end %>
        </div>

        <div class="card-chart">
          <% sparkline = multi_location_sparkline(checks_by_series, checks_by_series.keys, width: 440, height: 120) %>
          <% if sparkline %>
            <%= sparkline %>
          <% else %>
            <div class="card-no-data">Not enough data</div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <%= empty_state("No views yet.", "Add the first view", new_view_path) %>
<% end %>
