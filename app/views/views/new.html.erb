<h2>New view</h2>

<form method="get" action="<%= new_view_path %>" class="compare-form">
  <% [["s1", "Series 1", params[:s1]], ["s2", "Series 2", params[:s2]]].each do |key, label, current| %>
    <fieldset class="compare-series" data-controller="series-select">
      <legend><%= label %></legend>

      <div class="form-group">
        <label>Site</label>
        <select name="<%= key %>[site_id]"
                data-series-select-target="siteSelect"
                data-action="change->series-select#siteChanged">
          <option value="">Select site</option>
          <% @sites.each do |site| %>
            <option value="<%= site.id %>"
                    <%= "selected" if current&.dig(:site_id) == site.id.to_s %>>
              <%= site.name %> (<%= site.domain %>)
            </option>
          <% end %>
        </select>
      </div>

      <div class="form-group">
        <label>Keyword</label>
        <select name="<%= key %>[keyword_id]"
                data-series-select-target="keywordSelect"
                data-action="change->series-select#keywordChanged">
          <option value="">Select keyword</option>
          <% @all_keywords.each do |keyword| %>
            <option value="<%= keyword.id %>"
                    data-site-id="<%= keyword.site_id %>"
                    data-locations="<%= keyword.locations.to_json %>"
                    <%= "selected" if current&.dig(:keyword_id) == keyword.id.to_s %>>
              <%= keyword.query %>
            </option>
          <% end %>
        </select>
      </div>

      <div class="form-group">
        <label>Location</label>
        <select name="<%= key %>[location]"
                data-series-select-target="locationSelect">
          <option value="">Select location</option>
          <% if current&.dig(:location).present? && current&.dig(:keyword_id).present? %>
            <% kw = @all_keywords.find { |k| k.id.to_s == current[:keyword_id] } %>
            <% kw&.locations&.each do |code| %>
              <option value="<%= code %>" <%= "selected" if current[:location] == code %>>
                <%= country_flag(code) %> <%= country_name(code) %>
              </option>
            <% end %>
          <% end %>
        </select>
      </div>
    </fieldset>
  <% end %>

  <div class="compare-actions">
    <%= submit_tag "Create", class: "btn btn-primary" %>
  </div>
</form>

<% if @series1 && @series2 %>
  <% series = [
    { label: "#{@series1[:site].domain} — #{@series1[:keyword].query} — #{country_flag(@series1[:location])} #{country_name(@series1[:location])}", checks: @series1[:checks] },
    { label: "#{@series2[:site].domain} — #{@series2[:keyword].query} — #{country_flag(@series2[:location])} #{country_name(@series2[:location])}", checks: @series2[:checks] }
  ] %>
  <%= ranking_chart(series, empty_message: "Not enough data yet. Make sure both series have at least 2 successful checks.") %>

  <div data-controller="modal" class="save-view-wrapper">
    <button class="btn btn-secondary" data-action="click->modal#open">Save View</button>

    <dialog data-modal-target="dialog" data-action="click->modal#backdropClick" class="dialog">
      <%= form_tag views_path, method: :post do %>
        <% [[:s1, 0], [:s2, 1]].each do |key, idx| %>
          <%= hidden_field_tag "view[series][#{idx}][keyword_id]", params.dig(key, :keyword_id) %>
          <%= hidden_field_tag "view[series][#{idx}][location]",   params.dig(key, :location) %>
        <% end %>

        <h2 class="dialog-title">Save View</h2>
        <div class="field">
          <label for="view_name">Name</label>
          <%= text_field_tag "view[name]", nil, id: "view_name", autofocus: true, placeholder: "e.g. My site vs Competitor", required: true %>
        </div>
        <div class="dialog-actions">
          <%= submit_tag "Save", class: "btn btn-primary" %>
          <button type="button" class="btn btn-secondary" data-action="click->modal#close">Cancel</button>
        </div>
      <% end %>
    </dialog>
  </div>
<% end %>
