<div class="header">
  <h1><%= @view.name %></h1>
  <div class="header-actions">
    <%= link_to "Edit", edit_view_path(@view), class: "btn btn-secondary" %>
  </div>
</div>

<% series = @view.series.map { |s|
  {
    label: "#{s.keyword.site.domain} — #{s.keyword.query} — #{country_flag(s.location)} #{country_name(s.location)}",
    checks: s.keyword.checks.select { |c| c.success? && c.location == s.location }.sort_by(&:checked_at)
  }
} %>
<%= ranking_chart(series) %>
