<turbo-frame id="search-run-results">
  <div class="search-run-results">
    <div class="search-run-results-header">
      <strong><%= country_flag(@search_run.location) %> <%= country_name(@search_run.location) %></strong>
      <span class="muted"><%= @search_run.checked_at.strftime("%B %-d, %Y at %H:%M") %> · <%= pluralize(@search_run.requested_pages, "page") %></span>
    </div>

    <% if @ai_overview %>
      <div class="ai-overview">
        <div class="ai-overview-label">AI Overview</div>
        <% (@ai_overview[:text_blocks] || []).each do |block| %>
          <% if block[:snippet].present? %>
            <p class="ai-overview-text"><%= block[:snippet] %></p>
          <% end %>
        <% end %>
        <% if (sources = @ai_overview[:sources]).present? %>
          <div class="ai-overview-sources">
            <% sources.each do |source| %>
              <%= link_to (source[:title].presence || source[:domain] || source[:link]),
                    source[:link], target: "_blank", rel: "noopener", class: "ai-source" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @organic_results.any? %>
      <%= render "search_runs/organic_results", organic_results: @organic_results %>
    <% else %>
      <p class="muted">No search results recorded for this run.</p>
    <% end %>
  </div>
</turbo-frame>
