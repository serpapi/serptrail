<%# locals: (keyword:, search_runs:, selected_slot_start: nil, runs_by_location: {}, selected_run: nil, selected_location: nil, organic_results: [], ai_overview: nil) %>
<turbo-frame id="runs-section">
  <% chart = runs_column_chart(keyword, search_runs, selected_slot_start: selected_slot_start) %>
  <% if chart %>
    <div class="history-chart">
      <%= chart %>
    </div>
  <% end %>

  <% if runs_by_location.any? %>
    <div class="runs-location-picker">
      <span class="muted">Select location:</span>
      <% runs_by_location.each do |code, run| %>
        <% btn_class = "runs-location-btn#{code == selected_location ? " runs-location-btn--selected" : ""}" %>
        <%= link_to "#{country_flag(code)} #{country_name(code)}",
              keyword_search_runs_path(keyword, slot: selected_slot_start.to_i, location: code),
              class: btn_class,
              data: { turbo_frame: "runs-section" } %>
      <% end %>
    </div>
  <% end %>

  <% if selected_run %>
    <div class="search-run-results">
      <div class="search-run-results-header">
        <strong><%= country_flag(selected_run.location) %> <%= country_name(selected_run.location) %></strong>
        <span class="muted"><%= selected_run.checked_at.strftime("%B %-d, %Y at %H:%M") %></span>
      </div>

      <% if ai_overview %>
        <div class="ai-overview">
          <div class="ai-overview-label">AI Overview</div>
          <% (ai_overview[:text_blocks] || []).each do |block| %>
            <% if block[:snippet].present? %>
              <p class="ai-overview-text"><%= block[:snippet] %></p>
            <% end %>
          <% end %>
          <% if (sources = ai_overview[:sources]).present? %>
            <div class="ai-overview-sources">
              <% sources.each do |source| %>
                <%= link_to (source[:title].presence || source[:domain] || source[:link]),
                      source[:link], target: "_blank", rel: "noopener", class: "ai-source" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if organic_results.any? %>
        <ol class="organic-results">
          <% organic_results.first(20).each do |result| %>
            <li class="organic-result">
              <span class="result-position">#<%= result[:position] %></span>
              <div class="result-body">
                <%= link_to result[:title].presence || result[:link], result[:link], target: "_blank", rel: "noopener" %>
                <div class="result-url muted"><%= result[:link] %></div>
                <% if result[:snippet].present? %>
                  <p class="result-snippet"><%= result[:snippet] %></p>
                <% end %>
              </div>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="muted">No search results recorded for this run.</p>
      <% end %>
    </div>
  <% elsif runs_by_location.empty? && !chart %>
    <p class="muted">No search runs recorded yet.</p>
  <% end %>
</turbo-frame>
